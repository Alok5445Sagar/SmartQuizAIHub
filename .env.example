# Copy to .env and fill in. Never commit .env.

# --- Backend ---
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3306/smart_quiz_hub?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=smartquiz
DB_PASSWORD=change-me
# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value-of-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000
QUIZ_PUBLIC_BASE_URL=http://localhost:3000
