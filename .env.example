# Copy to .env and fill in. Never commit .env.

# --- Backend ---
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3306/smart_quiz_hub?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=smartquiz
DB_PASSWORD=change-me
# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value-of-at-least-32-bytes
# 2 hours
JWT_EXPIRATION_MS=7200000
CORS_ALLOWED_ORIGINS=http://localhost:3000
QUIZ_PUBLIC_BASE_URL=http://localhost:3000
CHAT_ATTACHMENTS_DIR=backend-data/chat-attachments
LOGIN_FAILURES_PER_MINUTE=5
CHAT_MESSAGES_PER_MINUTE=30

# --- AI (local Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5:3b is the CPU-friendly default. Use qwen2.5 (7B) if your machine is fast enough.
OLLAMA_MODEL=qwen2.5:3b
# never | when_missing | always
OLLAMA_PULL_STRATEGY=when_missing
OLLAMA_NUM_CTX=8192
AI_READ_TIMEOUT=300s
